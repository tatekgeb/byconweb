# Copy to .env for local dev. Set the same in your host (Railway, Vercel, etc.).

PUBLIC_TMS_APP_URL=https://tms.bycon.net

# Formspree contact form (demo + trial requests)
PUBLIC_FORMSPREE_FORM_ID=maqkbkjk

# Business phone shown on /contact (override if you change numbers)
PUBLIC_SALES_PHONE=(970) 489-8768

# Contact, privacy, legal, security, careers default to admin@ unless overridden (sales keeps its own mailbox).
PUBLIC_CONTACT_EMAIL=admin@bycon.net
PUBLIC_SALES_EMAIL=sales@bycon.net
PUBLIC_PRIVACY_EMAIL=admin@bycon.net
# Optional; defaults to PUBLIC_PRIVACY_EMAIL
PUBLIC_LEGAL_EMAIL=admin@bycon.net
PUBLIC_SECURITY_EMAIL=admin@bycon.net
PUBLIC_CAREERS_EMAIL=admin@bycon.net
