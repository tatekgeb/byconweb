---
/** Compliance center — driver names in sidebar and header masked for privacy. */
const src = '/marketing/compliance-center.png';
const alt =
  'Bycon compliance center showing document status, OIG/SAM checks, and missing items. Driver names redacted.';

/** Mask regions (% of image) for compliance-center.png (1024×611). */
const masks = [
  /** Left sidebar driver list */
  { top: 21.5, left: 0, width: 18.5, height: 78.5 },
  /** Selected driver name in main panel header */
  { top: 20.2, left: 19, width: 40, height: 8.5 },
];
---

<figure class="mkt-shot mkt-shot-compliance">
  <img src={src} width="1024" height="611" alt={alt} loading="lazy" decoding="async" />
  <div class="mkt-shot-masks" aria-hidden="true">
    {
      masks.map((mask) => (
        <span
          class="mkt-shot-mask"
          style={`top: ${mask.top}%; left: ${mask.left}%; width: ${mask.width}%; height: ${mask.height}%;`}
        />
      ))
    }
  </div>
  <figcaption class="mkt-shot-caption">Driver names redacted</figcaption>
</figure>
