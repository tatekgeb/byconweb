---
import { getSite } from '../lib/site';
import { ctas } from '../lib/marketing';

interface Props {
  defaultIntent?: 'demo' | 'trial';
}

const { defaultIntent = 'demo' } = Astro.props;
const { formspreeAction } = getSite();
---

<form
  class="contact-form"
  id="contact-form"
  action={formspreeAction}
  method="POST"
  data-default-intent={defaultIntent}
>
  <div class="contact-form-status" id="contact-form-status" role="status" aria-live="polite"></div>

  <div class="hp" aria-hidden="true">
    <label for="contact-_gotcha">Leave blank</label>
    <input type="text" id="contact-_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for="contact-name">Full name</label>
    <input type="text" id="contact-name" name="name" required autocomplete="name" />
  </div>

  <div class="field">
    <label for="contact-email">Work email</label>
    <input type="email" id="contact-email" name="email" required autocomplete="email" />
  </div>

  <div class="field">
    <label for="contact-company">Company</label>
    <input type="text" id="contact-company" name="company" required autocomplete="organization" />
  </div>

  <div class="field">
    <label for="contact-phone">Phone <span class="optional">(optional)</span></label>
    <input type="tel" id="contact-phone" name="phone" autocomplete="tel" />
  </div>

  <div class="field">
    <label for="contact-intent">What are you interested in?</label>
    <select id="contact-intent" name="request_type" required>
      <option value="demo">Request a demo</option>
      <option value="trial">Start free 30-day trial</option>
    </select>
  </div>

  <div class="field">
    <label for="contact-broker">Broker system <span class="optional">(optional)</span></label>
    <select id="contact-broker" name="broker">
      <option value="">Select…</option>
      <option value="Ecolane">Ecolane</option>
      <option value="MediDrive">MediDrive</option>
      <option value="Other">Other</option>
      <option value="Not sure">Not sure</option>
    </select>
  </div>

  <div class="field">
    <label for="contact-message">Message <span class="optional">(optional)</span></label>
    <textarea id="contact-message" name="message" rows="4" placeholder="Trips per day, markets, or anything we should know"></textarea>
  </div>

  <button type="submit" class="mkt-btn mkt-btn-primary" id="contact-submit">Send request</button>
  <p class="mkt-cta-note" style="margin-top: 0.75rem;">{ctas.replySla}</p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-form-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const intentSelect = document.getElementById('contact-intent') as HTMLSelectElement | null;

  if (form && statusEl && submitBtn) {
    const defaultIntent = form.dataset.defaultIntent || 'demo';
    if (intentSelect && (defaultIntent === 'demo' || defaultIntent === 'trial')) {
      intentSelect.value = defaultIntent;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      statusEl.className = 'contact-form-status';
      statusEl.textContent = '';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          statusEl.className = 'contact-form-status is-visible is-success';
          statusEl.textContent =
            'Thanks — we received your request and will reply within 1 business day.';
          form.reset();
          if (intentSelect) intentSelect.value = defaultIntent;
        } else {
          const data = await response.json().catch(() => null);
          const message =
            data?.error ||
            data?.errors?.map((e: { message: string }) => e.message).join(' ') ||
            'Something went wrong. Please try again or email sales@bycon.net.';
          statusEl.className = 'contact-form-status is-visible is-error';
          statusEl.textContent = message;
        }
      } catch {
        statusEl.className = 'contact-form-status is-visible is-error';
        statusEl.textContent = 'Network error. Please try again or email sales@bycon.net.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send request';
      }
    });
  }
</script>
