---
/** Dispatch day board — driver names masked for privacy. */
const src = '/marketing/day-board.png';
const alt =
  'Bycon dispatch day board showing unassigned trips, driver timelines, and trip blocks. Driver names redacted.';

/** Mask bands (% of image) aligned to the six driver rows in day-board.png (1024×611). */
const driverMasks = [
  { top: 39.8, left: 0, width: 15.5, height: 8.6 },
  { top: 49.2, left: 0, width: 15.5, height: 8.6 },
  { top: 58.6, left: 0, width: 15.5, height: 8.6 },
  { top: 68.0, left: 0, width: 15.5, height: 8.6 },
  { top: 77.4, left: 0, width: 15.5, height: 8.6 },
  { top: 86.8, left: 0, width: 15.5, height: 8.2 },
];
---

<figure class="mkt-shot mkt-shot-dayboard">
  <img src={src} width="1024" height="611" alt={alt} loading="lazy" decoding="async" />
  <div class="mkt-shot-masks" aria-hidden="true">
    {
      driverMasks.map((mask) => (
        <span
          class="mkt-shot-mask"
          style={`top: ${mask.top}%; left: ${mask.left}%; width: ${mask.width}%; height: ${mask.height}%;`}
        />
      ))
    }
  </div>
  <figcaption class="mkt-shot-caption">Driver names redacted</figcaption>
</figure>
