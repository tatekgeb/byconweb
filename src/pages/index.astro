---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home" description="Bycon — operations software for transportation, starting with NEMT-focused transport management.">
  <section style="margin-bottom: 2.5rem;">
    <h1 style="font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 700; letter-spacing: -0.03em; margin: 0 0 0.75rem;">
      Operations software for moving people—reliably and on the record.
    </h1>
    <p style="font-size: 1.0625rem; color: var(--muted); max-width: 36rem; margin: 0;">
      Bycon is a single company today, focused on a transport management platform built for brokers and providers who need
      audit-friendly operations, cleaner data, and tools that hold up in the field.
    </p>
  </section>
  <p style="margin: 0 0 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem;">
    <a
      href="/solutions"
      style="display: inline-block; padding: 0.65rem 1.15rem; background: var(--accent); color: #fff !important; border-radius: var(--radius); text-decoration: none; font-weight: 600; font-size: 0.9375rem;"
    >
      View solutions
    </a>
    <a href="/pricing" style="font-size: 0.9375rem; font-weight: 600;">Pricing</a>
    <a href="/contact" style="font-size: 0.9375rem; font-weight: 600;">Contact</a>
  </p>
</Layout>
