---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home" description="Bycon — operations software for transportation, starting with NEMT-focused transport management.">
  <div class="home">
    <section class="home-hero" aria-labelledby="home-heading">
      <p class="home-eyebrow">Transport operations</p>
      <h1 id="home-heading" class="home-title">
        Operations software for moving people—reliably and on the record.
      </h1>
      <p class="home-lead">
        Bycon builds a transport management platform for brokers and providers who need audit-friendly operations, cleaner
        data, and tools that hold up in the field.
      </p>
      <div class="home-cta">
        <a class="home-btn home-btn-primary" href="/solutions">View solutions</a>
        <a class="home-btn home-btn-ghost" href="/contact">Talk to us</a>
      </div>
      <p class="home-cta-secondary">
        <a href="/pricing">Pricing</a>
        <span class="home-dot" aria-hidden="true">·</span>
        <a href="/about">About</a>
      </p>
    </section>

    <ul class="home-trust" aria-label="What teams use Bycon for">
      <li class="home-trust-item">
        <span class="home-trust-label">NEMT &amp; broker networks</span>
        <span class="home-trust-desc">Scheduling and documentation built for compliance-heavy trips.</span>
      </li>
      <li class="home-trust-item">
        <span class="home-trust-label">Defensible records</span>
        <span class="home-trust-desc">Trip history and messaging that support audits and oversight.</span>
      </li>
      <li class="home-trust-item">
        <span class="home-trust-label">Field-ready</span>
        <span class="home-trust-desc">Dispatcher and driver workflows that match real operations.</span>
      </li>
    </ul>
  </div>

  <style>
    .home {
      max-width: 52rem;
      margin: 0 auto;
    }

    .home-hero {
      position: relative;
      padding: 2rem 1.5rem 1.75rem;
      margin: 0 -0.25rem 2.25rem;
      border-radius: 16px;
      border: 1px solid var(--border);
      background:
        linear-gradient(145deg, rgba(29, 78, 216, 0.07) 0%, rgba(248, 250, 252, 0.95) 42%, #ffffff 100%);
      box-shadow:
        0 1px 2px rgba(15, 23, 42, 0.04),
        0 12px 40px -18px rgba(29, 78, 216, 0.15);
      overflow: hidden;
    }

    .home-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), #60a5fa, var(--accent));
      opacity: 0.85;
    }

    .home-eyebrow {
      margin: 0 0 0.65rem;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .home-title {
      margin: 0 0 1rem;
      font-size: clamp(1.85rem, 4.5vw, 2.45rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.2;
      color: var(--text);
      max-width: 42rem;
    }

    .home-lead {
      margin: 0 0 1.5rem;
      font-size: 1.0625rem;
      line-height: 1.65;
      color: var(--muted);
      max-width: 38rem;
    }

    .home-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
      margin-bottom: 0.75rem;
    }

    .home-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 1.2rem;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      transition:
        transform 0.12s ease,
        box-shadow 0.12s ease;
    }

    .home-btn-primary {
      background: var(--accent);
      color: #fff !important;
      box-shadow: 0 2px 8px rgba(29, 78, 216, 0.35);
    }

    .home-btn-primary:hover {
      background: var(--accent-hover);
      color: #fff !important;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(29, 78, 216, 0.4);
    }

    .home-btn-ghost {
      background: #fff;
      color: var(--accent) !important;
      border: 1px solid rgba(29, 78, 216, 0.35);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .home-btn-ghost:hover {
      border-color: var(--accent);
      background: rgba(29, 78, 216, 0.04);
      color: var(--accent-hover) !important;
    }

    .home-cta-secondary {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .home-cta-secondary a {
      font-weight: 600;
    }

    .home-dot {
      margin: 0 0.35rem;
      color: var(--border);
    }

    .home-trust {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.75rem;
    }

    @media (min-width: 640px) {
      .home-trust {
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }
    }

    .home-trust-item {
      margin: 0;
      padding: 1rem 1rem 1rem 1.1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      border-left: 3px solid var(--accent);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    }

    .home-trust-label {
      display: block;
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 0.35rem;
    }

    .home-trust-desc {
      display: block;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--muted);
    }

    @media (max-width: 639px) {
      .home-hero {
        margin-left: 0;
        margin-right: 0;
        padding: 1.75rem 1.25rem 1.5rem;
      }
    }
  </style>
</Layout>
