---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSite } from '../lib/site';
import { ctas } from '../lib/marketing';

const { salesEmail, salesPhone, tmsUrl } = getSite();

const intentParam = Astro.url.searchParams.get('intent');
const defaultIntent = intentParam === 'trial' ? 'trial' : 'demo';
---
<Layout
  title="Contact"
  description="Request a Bycon demo or start a free 30-day trial for Medicaid NEMT dispatch."
>
  <div class="contact-layout">
    <div>
      <span class="mkt-tag">Get started</span>
      <h1 class="contact-page-title">Request a demo or trial</h1>
      <p class="contact-page-lead">
        Request a demo or start your free 30-day trial. {ctas.trialNote}
      </p>

      <div class="contact-form-wrap">
        <ContactForm defaultIntent={defaultIntent} />
      </div>
    </div>

    <aside class="contact-aside">
      <h2>Prefer email?</h2>
      <p>
        <a href={`mailto:${salesEmail}?subject=Bycon%20demo%20or%20trial`}>{salesEmail}</a>
      </p>

      {
        salesPhone && (
          <>
            <h2>Phone</h2>
            <p>
              <a href={`tel:${salesPhone.replace(/\D/g, '')}`}>{salesPhone}</a>
            </p>
          </>
        )
      }

      <h2>Existing customers</h2>
      <p>
        The live TMS is at{' '}
        <a href={tmsUrl} rel="noopener noreferrer">{tmsUrl.replace(/^https?:\/\//, '')}</a>.
      </p>
    </aside>
  </div>
</Layout>
