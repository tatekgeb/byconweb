---
import Layout from '../layouts/Layout.astro';
import { aboutCopy, outcomes, integrations, ctas } from '../lib/marketing';
---
<Layout
  title="About"
  description="About Bycon — transport management built for Medicaid NEMT providers with in-house dispatch."
>
  <article class="prose about-page">
    <span class="mkt-tag">About</span>
    <h1>About Bycon</h1>
    <p class="lead">{aboutCopy.lead}</p>
    <p class="disclaimer">{aboutCopy.disclaimer}</p>

    <h2>What we help dispatch teams achieve</h2>
    <ul>
      {outcomes.map((item) => (
        <li>
          <strong>{item.title}</strong> — {item.description}
        </li>
      ))}
    </ul>

    <h2>Broker integrations</h2>
    <p>
      <strong>Today — Ecolane:</strong> {integrations.today[0].description}
    </p>
    <p>
      <strong>Roadmap — MediDrive:</strong> {integrations.roadmap[0].description}
    </p>
    <p style="font-size: 0.8125rem;">{integrations.disclaimer}</p>

    <div class="mkt-cta-row" style="margin-top: 1.5rem;">
      <a class="mkt-btn mkt-btn-primary" href={ctas.demo.href}>{ctas.demo.label}</a>
      <a class="mkt-btn mkt-btn-secondary" href={ctas.trial.href}>{ctas.trial.label}</a>
    </div>
    <p class="mkt-cta-note">{ctas.trialNote}</p>

    <details class="about-details">
      <summary>Technical capability overview</summary>
      <p style="font-size: 0.875rem; margin-top: 0.75rem;">
        For diligence: the platform covers trip lifecycle management, day-level scheduling and routing, client and driver
        SMS, operations reporting, driver documents and timesheets, and per-company administration. Capabilities vary by
        role and configuration. See <a href="/">the home page</a> for customer-facing outcomes.
      </p>
    </details>
  </article>

  <style>
    .about-page {
      max-width: 46rem;
    }
    .about-page .disclaimer {
      font-size: 0.8125rem;
      color: var(--muted);
      margin: -0.25rem 0 1.25rem;
      padding: 0.65rem 0.85rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .about-details {
      margin-top: 2rem;
      padding: 1rem 1.1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 0.875rem;
      color: var(--muted);
    }
    .about-details summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--text);
    }
  </style>
</Layout>
