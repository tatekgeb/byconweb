---
import Layout from '../layouts/Layout.astro';
import MarketingStory from '../components/MarketingStory.astro';
import { getSite } from '../lib/site';

const { tmsUrl } = getSite();
---
<Layout
  title="Solutions"
  description="Bycon TMS for Medicaid NEMT dispatch — day board, compliance center, automated Ecolane trip sync, MediDrive API on roadmap."
>
  <MarketingStory mode="solutions" />

  <p style="margin-top: 2rem; font-size: 0.875rem; color: var(--muted); max-width: 40rem;">
    Existing customers: the live application is at{' '}
    <a href={tmsUrl} rel="noopener noreferrer">{tmsUrl.replace(/^https?:\/\//, '')}</a>.
  </p>
</Layout>
